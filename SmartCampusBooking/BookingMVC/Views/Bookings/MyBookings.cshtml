@model List<BookingMVC.Models.BookingViewModel>

@{
    ViewData["Title"] = "My Bookings";
}

<div class="container mt-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>My Bookings</h2>
        <a asp-controller="Bookings"
           asp-action="Create"
           class="btn btn-primary">
            + New Booking
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger">
            @ViewBag.ErrorMessage
        </div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            You don't have any bookings yet.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-bordered table-hover align-middle">

                <thead class="table-dark">
                    <tr>
                        <th>Booking ID</th>
                        <th>Facility</th>
                        <th>Start Time</th>
                        <th>End Time</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var booking in Model)
                    {
                        <tr>
                            <td>@booking.Id</td>
                            <td>@booking.FacilityName</td>
                            <td>@booking.StartTime.ToString("dd MMM yyyy hh:mm tt")</td>
                            <td>@booking.EndTime.ToString("dd MMM yyyy hh:mm tt")</td>

                            <td>
                                @if (booking.Status == "Confirmed")
                                {
                                    <span class="badge bg-success">
                                        Confirmed
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        @booking.Status
                                    </span>
                                }
                            </td>

                            <td>
                                @if (booking.Status == "Confirmed")
                                {
                                    <form asp-controller="Bookings"
                                          asp-action="Cancel"
                                          method="post"
                                          onsubmit="return confirm('Are you sure you want to cancel this booking?');">

                                        <input type="hidden"
                                               name="id"
                                               value="@booking.Id" />

                                        <button type="submit"
                                                class="btn btn-danger btn-sm">
                                            Cancel
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <span class="text-muted">
                                        No actions available
                                    </span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>

            </table>
        </div>
    }
</div>
