@model List<FacilityAdminViewModel>
@{ ViewData["Title"] = "Facility Management"; }
<div class="container py-4">
    <a asp-controller="Home" asp-action="Index" class="text-decoration-none">&larr; Dashboard</a>
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 my-3">
        <div><h1 class="fw-bold mb-1">Facility Management</h1><p class="text-muted mb-0">Manage campus rooms, labs and equipment.</p></div>
        <a asp-action="Create" class="btn btn-primary">+ Add Facility</a>
    </div>
    @if (TempData["FacilitySuccess"] is string success) { <div class="alert alert-success" role="status">@success</div> }
    @if (TempData["FacilityError"] is string error) { <div class="alert alert-danger" role="alert">@error</div> }
    @if (ViewBag.Error != null) { <div class="alert alert-danger" role="alert">@ViewBag.Error</div> }
    else {
        <div class="row g-3 mb-4">
            <div class="col-md-4"><div class="card border-0 shadow-sm rounded-4 p-3"><span class="text-muted">Total facilities</span><strong class="fs-2">@ViewBag.Total</strong></div></div>
            <div class="col-md-4"><div class="card border-0 shadow-sm rounded-4 p-3"><span class="text-muted">Available</span><strong class="fs-2 text-success">@ViewBag.Available</strong></div></div>
            <div class="col-md-4"><div class="card border-0 shadow-sm rounded-4 p-3"><span class="text-muted">Maintenance</span><strong class="fs-2 text-warning">@ViewBag.Maintenance</strong></div></div>
        </div>
        <form method="get" asp-action="Index" class="d-flex flex-wrap gap-2 mb-3">
            <input name="keyword" value="@ViewBag.Keyword" class="form-control flex-grow-1 w-auto" aria-label="Search facilities" placeholder="Search name, type or building" />
            <button class="btn btn-outline-primary">Search</button><a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
        </form>
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden"><div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light"><tr><th class="ps-3">Facility</th><th>Type</th><th>Capacity</th><th>Status</th><th>Actions</th></tr></thead>
                <tbody>
                @foreach(var facility in Model) {
                    <tr><td class="ps-3"><strong>@facility.Name</strong><div class="text-muted small">@facility.Location</div></td><td>@facility.Type</td><td>@facility.Capacity</td>
                    <td><span class="badge @(facility.Status == "Available" ? "bg-success" : "bg-warning text-dark")">@facility.Status</span></td>
                    <td><div class="d-flex flex-wrap gap-2"><a asp-action="Details" asp-route-id="@facility.Id" class="btn btn-sm btn-outline-secondary">View</a><a asp-action="Edit" asp-route-id="@facility.Id" class="btn btn-sm btn-outline-primary">Edit</a><form asp-action="Delete" asp-route-id="@facility.Id" method="post"><button class="btn btn-sm btn-outline-danger">Delete</button></form></div></td></tr>
                }
                @if(Model.Count == 0) { <tr><td colspan="5" class="text-center text-muted py-4">No matching facilities. Add a facility or change your search.</td></tr> }
                </tbody>
            </table>
        </div></div>
    }
</div>
