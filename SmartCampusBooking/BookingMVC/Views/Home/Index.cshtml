@using System.Security.Claims

@{
    ViewData["Title"] = "Dashboard";

    var name = User.Identity?.Name ?? "User";
    var role = User.FindFirst(ClaimTypes.Role)?.Value ?? "";
}

<div class="container py-4">

    <div class="mb-5">
        <h1 class="fw-bold">Welcome, @name</h1>
        <p class="text-muted">
            Smart Campus Dashboard — @role
        </p>
    </div>

    <div class="row g-4">

        @if (User.IsInRole("Student") ||
             User.IsInRole("Faculty"))
        {
            <div class="col-md-6">
                <div class="card border-0 shadow-sm rounded-4 h-100">
                    <div class="card-body p-4">
                        <h4>Book a Facility</h4>
                        <p class="text-muted">
                            Reserve a study room, lab or other
                            campus facility.
                        </p>

                        <a asp-controller="Bookings"
                           asp-action="Create"
                           class="btn btn-primary">
                            Make a Booking
                        </a>
                        <a asp-controller="FacilityExplorer"
                           asp-action="Index"
                           class="btn btn-outline-primary">
                            Explore Facilities
                        </a>
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="card border-0 shadow-sm rounded-4 h-100">
                    <div class="card-body p-4">
                        <h4>My Bookings</h4>
                        <p class="text-muted">
                            View your bookings and cancel existing reservations.
                        </p>

                        <a asp-controller="Bookings"
                           asp-action="MyBookings"
                           class="btn btn-outline-primary">
                            View My Bookings
                        </a>
                    </div>
                </div>
            </div>
        }

        <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">
                    <h4>My Profile</h4>
                    <p class="text-muted">
                        View your account details and role.
                    </p>

                    <a asp-controller="Account"
                       asp-action="Profile"
                       class="btn btn-outline-primary">
                        View Profile
                    </a>
                </div>
            </div>
        </div>

        @if (User.IsInRole("Admin"))
        {
            <div class="col-md-6">
                <div class="card border-0 shadow-sm rounded-4 h-100">
                    <div class="card-body p-4">
                        <h4>Admin Dashboard</h4>
                        <p class="text-muted">
                            Manage campus facilities and events.
                        </p>
                        <a asp-controller="AdminFacilities"
                           asp-action="Index"
                           class="btn btn-primary">
                            Manage Facilities
                        </a>

                        <span class="badge bg-secondary">
                            Admin modules coming soon
                        </span>
                    </div>
                </div>
            </div>
        }

    </div>
</div>
