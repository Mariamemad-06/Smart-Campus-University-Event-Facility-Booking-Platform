
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Smart Campus</title>

    <script type="importmap"></script>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/BookingMVC.styles.css"
          asp-append-version="true" />
</head>

<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom shadow-sm mb-3">
            <div class="container-fluid">

                <a class="navbar-brand fw-bold"
                   asp-controller="Home"
                   asp-action="Index">
                    Smart Campus
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar"
                        aria-expanded="false"
                        aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse"
                     id="mainNavbar">

                    <!-- Existing navigation -->
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Index">
                                Home
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Privacy">
                                Privacy
                            </a>
                        </li>
                    </ul>

                    <!-- Member 1: Authentication navigation -->
                    
<ul class="navbar-nav ms-auto align-items-sm-center">

    @if (User.Identity?.IsAuthenticated == true)
    {
        <!-- Logged-in user's name -->
        <li class="nav-item">
            <span class="nav-link">
                Hello, @User.Identity.Name
            </span>
        </li>

        <!-- Notifications bell for Students and Faculty -->
@if (User.IsInRole("Student") || User.IsInRole("Faculty"))
{
    <li class="nav-item">
        <a class="nav-link notification-link ms-2"
           asp-controller="Notifications"
           asp-action="Index"
           title="My Notifications"
           aria-label="My Notifications">

            <span class="notification-bell-wrapper">

                <svg xmlns="http://www.w3.org/2000/svg"
                     width="22"
                     height="22"
                     fill="currentColor"
                     viewBox="0 0 16 16"
                     class="notification-bell-icon">

                    <path d="M8 16a2 2 0 0 0 2-2H6a2 2 0 0 0 2 2z"/>

                    <path d="M8 1.5a1 1 0 0 1 1 1v.3
                             c1.7.4 2.8 1.8 2.8 3.6v2.5
                             c0 .7.3 1.4.8 1.9l.6.6
                             H2.8l.6-.6c.5-.5.8-1.2.8-1.9V6.4
                             c0-1.8 1.1-3.2 2.8-3.6v-.3
                             a1 1 0 0 1 1-1z"/>
                </svg>

                <span class="notification-badge d-none"
      id="notificationBadge"
      data-count-url="@Url.Action("UnreadCount", "Notifications")">
</span>

            </span>
        </a>
    </li>
}
        <!-- Profile -->
        <li class="nav-item">
            <a class="nav-link"
               asp-controller="Account"
               asp-action="Profile">
                My Profile
            </a>
        </li>

        <!-- Logout -->
        <li class="nav-item">
            <form asp-controller="Account"
                  asp-action="Logout"
                  method="post"
                  class="mb-0">

                @Html.AntiForgeryToken()

                <button type="submit"
                        class="btn btn-outline-danger btn-sm ms-sm-2">
                    Logout
                </button>
            </form>
        </li>
    }
    else
    {
        <!-- Login -->
        <li class="nav-item">
            <a class="nav-link"
               asp-controller="Account"
               asp-action="Login">
                Login
            </a>
        </li>

        <!-- Register -->
        <li class="nav-item">
            <a class="btn btn-primary btn-sm ms-sm-2"
               asp-controller="Account"
               asp-action="Register">
                Register
            </a>
        </li>
    }

</ul>

                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Smart Campus
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>


    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
